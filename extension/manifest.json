{
  "manifest_version": 3,
  "name": "CC Translator",
  "version": "0.1.0",
  "description": "Live Spanish closed captions from the video's audio, with English translation, shown together over the player.",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "CC Translator",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.netflix.com/*",
        "https://www.disneyplus.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.crunchyroll.com/*"
      ],
      "js": ["settings.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
